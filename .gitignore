# Dependencies
node_modules/

# Environment variables
.env
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db

# IDEs
.idea/
.vscode/
.fleet/

# TanStack Start (frontend has its own .gitignore too)
frontend/.output/
frontend/.nitro/
frontend/.tanstack/
frontend/.vinxi/
frontend/dist/

# Logs
logs/
*.log

# Go (api + ws)
# NOTE: go.sum must NEVER be ignored — it locks dependency checksums and is required for
# reproducible builds. A prior "*.sum" rule here once silently excluded every go.sum from every
# commit ever made in this repo; removed, and they're now tracked for real.
*.exe
backend/api/quotes-api
backend/ws/quotes-ws
