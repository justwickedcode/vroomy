# Dependencies
node_modules/

# Environment variables
.env
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db

# IDEs
.idea/
.vscode/
.fleet/

# TanStack Start (frontend has its own .gitignore too)
frontend/.output/
frontend/.nitro/
frontend/.tanstack/
frontend/.vinxi/
frontend/dist/

# Logs
logs/
*.log

# Go (scraper + api)
# NOTE: go.sum must NEVER be ignored — it locks dependency checksums and is required for
# reproducible builds. A prior "*.sum" rule here silently excluded both backend/scraper/go.sum
# and backend/api/go.sum from every commit ever made in this repo; removed, and both files are
# now tracked for real.
backend/scraper/vendor/
*.exe
backend/api/quotes-api
