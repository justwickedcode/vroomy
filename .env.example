# Copy this to .env.prod and fill in real, randomly-generated secrets — never reuse the dev
# placeholder values (postgres/postgres, redis) here. Used by:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# Generate strong random values with, e.g.: openssl rand -base64 24

POSTGRES_USER=quotes
POSTGRES_PASSWORD=REPLACE_WITH_A_REAL_RANDOM_SECRET
POSTGRES_DB=quotes

REDIS_PASSWORD=REPLACE_WITH_A_REAL_RANDOM_SECRET

# The real, deployed frontend URL — not localhost. This is the one origin the API will accept
# cross-origin requests from.
CORS_ALLOWED_ORIGIN=https://your-frontend-domain.example.com
