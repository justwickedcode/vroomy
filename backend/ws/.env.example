# Copy this file to .env and fill in real values. .env is gitignored — never commit real
# credentials.

# This service reads the same "quotes" Postgres database backend/scraper writes to — see
# backend/scraper/docker-compose.yml for that database's own container. It does not run its own
# database and does not run migrations (backend/scraper owns the schema); run the scraper
# against a fresh database at least once before starting this service.
DATABASE_URL=postgres://postgres:postgres@localhost:55432/quotes?sslmode=disable

# Which port this service listens on, and which frontend origin it accepts WebSocket upgrades
# from. In production, set this to the real deployed frontend URL (e.g.
# https://vroomy.example.com), not localhost.
WS_PORT=8081
CORS_ALLOWED_ORIGIN=http://localhost:3000
